---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Pilares from '../components/Pilares.astro';
import Resultados from '../components/Resultados.astro';
import Oferta from '../components/Oferta.astro';
import SystemFlow from '../components/SystemFlow.astro';
import Cases from '../components/Cases.astro';
import Credenciais from '../components/Credenciais.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Canal from '../components/Canal.astro';
import Recursos from '../components/Recursos.astro';
import TechCarousel from '../components/TechCarousel.astro';
import About from '../components/About.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
import Scripts from '../components/Scripts.astro';
---

<BaseLayout title="Sistemas, Automações e IA para Empresas | Gabriel Rabelo" description="Sistemas digitais, automações e soluções com IA para empresas venderem mais, reduzirem custos e eliminarem trabalho manual.">
    <Navigation />
    <main>
        <Hero />
        <Pilares />
        <Resultados />
        <Oferta />
        <SystemFlow />
        <Cases />
        <Credenciais />
        <ComoFunciona />
        <Canal />
        <Recursos />
        <section class="py-16 md:py-24 border-y border-white/5 overflow-hidden" aria-label="Tecnologia por trás das soluções"><TechCarousel /></section>
        <About />
        <FinalCTA />
    </main>
    <Footer />
    <Scripts />
</BaseLayout>
