---
const pilares = [
    { icon: "circle-dollar-sign", title: "Mais faturamento", text: "Mais oportunidades captadas, respostas mais rápidas e menos leads esquecidos.", color: "text-accent-success", border: "border-accent-success/30" },
    { icon: "chart-no-axes-column-decreasing", title: "Menos custo", text: "Menos retrabalho, tarefas repetitivas e horas gastas em operação manual.", color: "text-accent-primary", border: "border-accent-primary/30" },
    { icon: "clock-3", title: "Mais tempo", text: "Processos conectados para sua equipe focar em atender, decidir e crescer.", color: "text-accent-tertiary", border: "border-accent-tertiary/30" },
];
---

<section id="pilares" class="relative pb-16 md:pb-24">
    <div class="container mx-auto px-6 lg:px-12 max-w-7xl">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            {pilares.map((pilar, i) => (
                <article class={`glass-card rounded-2xl p-6 md:p-8 border ${pilar.border} reveal`} style={`transition-delay: ${i * 80}ms;`}>
                    <div class="flex items-center gap-4 mb-4">
                        <i data-lucide={pilar.icon} class={`w-7 h-7 ${pilar.color}`}></i>
                        <h2 class="text-xl md:text-2xl font-bold text-white">{pilar.title}</h2>
                    </div>
                    <p class="text-text-secondary leading-relaxed">{pilar.text}</p>
                </article>
            ))}
        </div>
    </div>
</section>
