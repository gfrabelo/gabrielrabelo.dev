<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') lucide.createIcons();

        const reveals = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => entry.target.classList.toggle('active', entry.isIntersecting));
            }, { rootMargin: '0px 0px -80px', threshold: 0.08 });
            reveals.forEach((element) => observer.observe(element));
        } else {
            reveals.forEach((element) => element.classList.add('active'));
        }

        const scrollTopBtn = document.getElementById('scroll-top');
        window.addEventListener('scroll', () => {
            if (!scrollTopBtn) return;
            const visible = window.scrollY > 500;
            scrollTopBtn.style.opacity = visible ? '1' : '0';
            scrollTopBtn.style.pointerEvents = visible ? 'auto' : 'none';
        }, { passive: true });

        document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
            anchor.addEventListener('click', (event) => {
                const selector = anchor.getAttribute('href');
                if (!selector || selector === '#') return;
                const target = document.querySelector(selector);
                if (target) { event.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
            });
        });

        window.dataLayer = window.dataLayer || [];
        const track = (eventName, parameters = {}) => {
            const payload = { event: eventName, ...parameters };
            window.dataLayer.push(payload);
            window.dispatchEvent(new CustomEvent('site:track', { detail: payload }));
        };
        window.siteTrack = track;

        document.querySelectorAll('[data-track]').forEach((element) => {
            element.addEventListener('click', () => track(element.dataset.track, {
                label: element.dataset.trackLabel || element.textContent.trim(),
                location: element.dataset.trackLocation || null,
                path: window.location.pathname,
            }));
        });

        const form = document.getElementById('resource-form');
        if (form) {
            const params = new URLSearchParams(window.location.search);
            ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach((name) => {
                const input = form.querySelector(`[name="${name}"]`);
                if (input) input.value = params.get(name) || '';
            });

            form.addEventListener('submit', async (event) => {
                event.preventDefault();
                if (!form.reportValidity()) return;
                const button = form.querySelector('button[type="submit"]');
                const original = button?.innerHTML;
                if (button) { button.disabled = true; button.textContent = 'Liberando material…'; }
                const data = Object.fromEntries(new FormData(form).entries());
                const endpoint = form.dataset.endpoint;
                try {
                    if (endpoint) {
                        const response = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...data, resource: form.dataset.resource, page: window.location.href }) });
                        if (!response.ok) throw new Error('Falha no envio');
                    }
                    track('resource_form_submit', { resource: form.dataset.resource, profile: data.profile, has_utm: Boolean(data.utm_source || data.utm_campaign) });
                    form.classList.add('hidden');
                    document.getElementById('resource-success')?.classList.remove('hidden');
                    const link = document.createElement('a');
                    link.href = form.dataset.download;
                    link.download = '';
                    document.body.appendChild(link); link.click(); link.remove();
                    if (typeof lucide !== 'undefined') lucide.createIcons();
                } catch (error) {
                    track('resource_form_error', { resource: form.dataset.resource });
                    alert('Não foi possível liberar o material agora. Tente novamente em instantes.');
                    if (button) { button.disabled = false; button.innerHTML = original; }
                }
            });
        }
    });
</script>
