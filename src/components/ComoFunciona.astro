---
const passos = [
    {
        numero: "01",
        cor: "primary",
        titulo: "Conversa de 15 minutos",
        desc: "Você me conta como o cliente chega até você hoje e onde está travando. Eu digo o que faz sentido no seu caso, e o que não faz. Se eu achar que você não precisa contratar nada, eu falo.",
    },
    {
        numero: "02",
        cor: "secondary",
        titulo: "Proposta com preço e prazo",
        desc: "Escopo fechado, preço fechado, data de entrega fechada. Sem contador rodando por hora e sem descobrir custo novo no meio do caminho.",
    },
    {
        numero: "03",
        cor: "tertiary",
        titulo: "Entrego e acompanho",
        desc: "Coloco no ar, testo com você usando de verdade e acompanho as primeiras semanas pra ajustar o que a realidade mostrar diferente do combinado.",
    },
];

const corMap: Record<string, { border: string; text: string; dot: string; shadow: string }> = {
    primary: { border: "border-accent-primary", text: "group-hover:text-accent-primary", dot: "bg-accent-primary", shadow: "rgba(99,102,241,0.5)" },
    secondary: { border: "border-accent-secondary", text: "group-hover:text-accent-secondary", dot: "bg-accent-secondary", shadow: "rgba(139,92,246,0.5)" },
    tertiary: { border: "border-accent-tertiary", text: "group-hover:text-accent-tertiary", dot: "bg-accent-tertiary", shadow: "rgba(6,182,212,0.5)" },
};

const whatsapp = "https://api.whatsapp.com/send?phone=5511921586783&text=Oi%20Gabriel%2C%20vi%20seu%20site%20e%20queria%20entender%20como%20funciona.";
---

<section id="como-funciona" class="py-16 md:py-32 relative overflow-hidden bg-bg-surface border-y border-white/5">
    <div class="container mx-auto px-6 lg:px-12 max-w-5xl">
        <div class="mb-20 reveal text-center">
            <h2 class="text-sm font-bold text-accent-tertiary tracking-widest uppercase mb-4">Como funciona</h2>
            <h2 class="text-4xl md:text-5xl font-bold text-white tracking-tight">Três passos, sem burocracia</h2>
            <p class="mt-4 text-text-secondary">Você fala comigo direto. Não tem atendente, não tem reunião de alinhamento sobre reunião.</p>
        </div>

        <div class="space-y-6">
            {passos.map((p, i) => (
                <div class="group glass-card rounded-[32px] p-8 md:p-10 flex flex-col md:flex-row gap-6 md:gap-10 items-start reveal" style={`transition-delay: ${i * 100}ms;`}>
                    <div class={`flex-shrink-0 w-16 h-16 rounded-2xl border-2 ${corMap[p.cor].border} flex items-center justify-center font-bold text-xl text-white group-hover:scale-110 transition-transform duration-500`} style={`box-shadow: 0 0 20px ${corMap[p.cor].shadow};`}>
                        {p.numero}
                    </div>
                    <div>
                        <h3 class={`text-2xl font-bold text-white mb-3 ${corMap[p.cor].text} transition-colors`}>{p.titulo}</h3>
                        <p class="text-text-secondary leading-relaxed">{p.desc}</p>
                    </div>
                </div>
            ))}
        </div>

        <div class="mt-16 text-center reveal">
            <a href={whatsapp} target="_blank" class="inline-flex items-center gap-3 bg-gradient-to-r from-accent-primary to-accent-secondary text-white font-bold py-4 px-8 rounded-full shadow-[0_10px_30px_rgba(99,102,241,0.4)] hover:shadow-[0_15px_40px_rgba(99,102,241,0.6)] hover:-translate-y-1 transition-all duration-300">
                <i data-lucide="message-circle" class="w-5 h-5"></i>
                Começar pela conversa de 15 min
            </a>
        </div>
    </div>
</section>

<script>
    if (typeof lucide !== 'undefined') {
        lucide.createIcons();
    }
</script>
