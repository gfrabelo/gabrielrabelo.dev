---
const cases = [
    {
        image: "/img/aurea.webp", color: "secondary", title: "Aurea", context: "Clínica estética",
        problem: "A recepção gastava horas respondendo dúvidas repetidas e oportunidades esfriavam fora do horário.",
        solution: "Um agente de WhatsApp responde, esclarece procedimentos e pré-agenda na agenda da clínica.",
        result: "Em 7 dias, foram 47 horas economizadas, R$ 12.450 em procedimentos agendados e 61% dos leads convertidos em agendamento.",
        tech: "Agente de IA · WhatsApp · Agenda", tags: ["47h economizadas", "R$ 12.450 em 7 dias", "61% agendados"],
    },
    {
        image: "/img/nexus-dark-mode.webp", color: "success", title: "Nexus", context: "Operação de superiates",
        problem: "A tripulação precisava controlar a manutenção em alto mar, mesmo durante longos períodos sem internet.",
        solution: "Um sistema que funciona dentro do navegador, guarda os dados offline e sincroniza quando o sinal volta.",
        result: "Produto validado com cliente pagante e primeira venda fechada em contrato de um ano.",
        tech: "Aplicação web · Offline-first · Sincronização", tags: ["Cliente pagante", "Contrato de 1 ano", "Funciona offline"],
    },
    {
        image: "/img/odin.webp", color: "primary", title: "Odin", context: "Pesquisa e produção de conteúdo",
        problem: "Pesquisar, qualificar fontes e transformar informação em texto exigia muitas etapas manuais.",
        solution: "Uma equipe de agentes executa as etapas em sequência, mantendo aprovação humana antes da publicação.",
        result: "Pesquisa, qualificação e primeira versão reunidas em um fluxo único e supervisionado.",
        tech: "Multiagentes · Pesquisa · Aprovação humana", tags: ["Pesquisa automatizada", "Fluxo conectado", "Revisão humana"],
    },
];
const textColor: Record<string, string> = { primary: "text-accent-primary", secondary: "text-accent-secondary", success: "text-accent-success" };
const whatsapp = "https://api.whatsapp.com/send?phone=5511921586783&text=Oi%20Gabriel%2C%20vi%20seus%20cases%20e%20quero%20conversar%20sobre%20uma%20solu%C3%A7%C3%A3o.";
---

<section id="cases" class="py-16 md:py-28 relative">
    <div class="absolute inset-0 max-w-7xl mx-auto opacity-20 pointer-events-none bg-gradient-radial from-accent-primary/20 to-transparent blur-[100px]"></div>
    <div class="container mx-auto px-4 sm:px-6 lg:px-12 max-w-6xl relative z-10">
        <div class="text-center mb-16 md:mb-20 reveal">
            <p class="text-sm font-bold text-accent-tertiary tracking-widest uppercase mb-3">Cases</p>
            <h2 class="text-3xl sm:text-4xl md:text-6xl font-bold text-white tracking-tight mb-5">Problema real. Solução aplicada. Resultado.</h2>
            <p class="text-text-secondary text-lg max-w-2xl mx-auto">A tecnologia aparece depois que o contexto do negócio está claro.</p>
        </div>

        <div class="space-y-8">
            {cases.map((item, i) => (
                <article class="group glass-card rounded-2xl sm:rounded-[32px] overflow-hidden reveal" style={`transition-delay: ${i * 80}ms;`}>
                    <div class="grid lg:grid-cols-5">
                        <div class="relative min-h-[240px] lg:col-span-2 bg-black/40 overflow-hidden">
                            <img src={item.image} alt={`Interface do projeto ${item.title}`} class="absolute inset-0 w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700" loading="lazy" decoding="async" />
                            <div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-bg-card/90 via-transparent to-transparent"></div>
                            <div class="absolute left-6 bottom-6"><span class={`text-xs font-mono uppercase tracking-wider px-3 py-1.5 rounded-full bg-black/60 border border-white/10 ${textColor[item.color]}`}>{item.context}</span></div>
                        </div>
                        <div class="p-6 sm:p-8 lg:p-10 lg:col-span-3">
                            <div class="flex flex-wrap justify-between items-start gap-4 mb-7">
                                <h3 class="text-3xl font-bold text-white">{item.title}</h3>
                                <span class="text-xs text-text-muted font-mono">{item.tech}</span>
                            </div>
                            <div class="grid sm:grid-cols-3 gap-5 mb-7">
                                <div><p class="text-xs uppercase tracking-wider text-text-muted mb-2">Problema</p><p class="text-sm text-text-secondary leading-relaxed">{item.problem}</p></div>
                                <div><p class="text-xs uppercase tracking-wider text-text-muted mb-2">Solução</p><p class="text-sm text-text-secondary leading-relaxed">{item.solution}</p></div>
                                <div><p class={`text-xs uppercase tracking-wider mb-2 ${textColor[item.color]}`}>Resultado</p><p class="text-sm text-white leading-relaxed">{item.result}</p></div>
                            </div>
                            <div class="flex flex-wrap items-center gap-2">
                                {item.tags.map((tag) => <span class={`px-3 py-1.5 rounded-xl bg-white/5 border border-white/10 text-xs ${textColor[item.color]}`}>{tag}</span>)}
                                <a href={whatsapp} target="_blank" rel="noopener noreferrer" data-track="case_click" data-track-label={item.title} class="sm:ml-auto inline-flex items-center gap-2 text-sm text-white hover:text-accent-tertiary transition-colors">Conversar sobre algo assim <i data-lucide="arrow-up-right" class="w-4 h-4"></i></a>
                            </div>
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </div>
</section>
