---
interface Props {
    src: string;
    alt: string;
    category: string;
    title: string;
    desc: string;
    chip: string;
    accent: "primary" | "secondary" | "tertiary" | "success";
    idleBorder?: boolean;
}
const { src, alt, category, title, desc, chip, accent, idleBorder = false } = Astro.props;

const colorMap = {
    primary: { text: "text-accent-primary", chip: "bg-accent-primary/20 text-accent-primary border-accent-primary/20", idle: "border-accent-primary/20", hover: "group-hover:border-accent-primary/30" },
    secondary: { text: "text-accent-secondary", chip: "bg-accent-secondary/20 text-accent-secondary border-accent-secondary/20", idle: "border-accent-secondary/20", hover: "group-hover:border-accent-secondary/30" },
    tertiary: { text: "text-accent-tertiary", chip: "bg-accent-tertiary/20 text-accent-tertiary border-accent-tertiary/20", idle: "border-accent-tertiary/20", hover: "group-hover:border-accent-tertiary/30" },
    success: { text: "text-accent-success", chip: "bg-accent-success/20 text-accent-success border-accent-success/20", idle: "border-accent-success/20", hover: "group-hover:border-accent-success/30" },
} as const;
const c = colorMap[accent];
---

<div class={`group relative flex-shrink-0 w-[300px] rounded-3xl overflow-hidden aspect-[4/3] cursor-pointer shadow-2xl ${idleBorder ? `border-2 ${c.idle}` : ""}`}>
    <img src={src} alt={alt} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 grayscale-[30%] group-hover:grayscale-0" loading="lazy" decoding="async">
    <div class="absolute inset-0 bg-gradient-to-t from-bg-main via-bg-main/80 to-transparent opacity-90 group-hover:opacity-100 transition-all duration-300 flex flex-col justify-end p-8 backdrop-blur-[2px] group-hover:backdrop-blur-none">
        <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
            <div class="flex items-center justify-between mb-2">
                <span class={`${c.text} text-xs font-bold uppercase tracking-widest`}>{category}</span>
                <i data-lucide="arrow-up-right" class="w-5 h-5 text-white opacity-0 group-hover:opacity-100 transition-opacity duration-500"></i>
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">{title}</h3>
            <p class="text-text-secondary text-sm mb-4 opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">{desc}</p>
            <div class={`inline-block px-3 py-1 rounded font-mono text-sm font-bold border ${c.chip}`}>
                {chip}
            </div>
        </div>
    </div>
    <div class={`absolute inset-0 border-2 border-transparent ${c.hover} rounded-3xl transition-colors duration-300 pointer-events-none`}></div>
</div>
