---
interface Props { basePath?: string; }
const { basePath = "" } = Astro.props;
const links = [
    { href: "#solucoes", label: "Soluções" },
    { href: "#resultados", label: "Resultados" },
    { href: "#como-funciona", label: "Como funciona" },
    { href: "#conteudo", label: "Conteúdo" },
    { href: "#recursos", label: "Recursos" },
    { href: "#sobre", label: "Sobre" },
];
const whatsapp = "https://api.whatsapp.com/send?phone=5511921586783&text=Oi%20Gabriel%2C%20vi%20seu%20site%20e%20quero%20entender%20onde%20a%20tecnologia%20pode%20gerar%20resultado%20no%20meu%20neg%C3%B3cio.";
---

<nav class="fixed top-0 w-full z-50 glass-nav h-20 transition-all duration-300" aria-label="Navegação principal">
    <div class="container mx-auto px-6 lg:px-12 h-full flex justify-between items-center max-w-7xl">
        <a href={`${basePath}#home`} class="group flex items-center gap-2" aria-label="Gabriel Rabelo — início">
            <span class="text-xl font-bold tracking-tight text-white/90 group-hover:text-white transition-colors">Gabriel Rabelo<span class="text-accent-primary">.</span></span>
        </a>

        <div class="hidden lg:flex items-center gap-5 xl:gap-7">
            {links.map((link) => (
                <a href={`${basePath}${link.href}`} class="relative text-sm font-medium text-text-secondary hover:text-white transition-colors group">
                    {link.label}<span class="absolute -bottom-1 left-0 w-0 h-[2px] bg-accent-primary transition-all group-hover:w-full"></span>
                </a>
            ))}
        </div>

        <div class="flex items-center gap-3">
            <a href={whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-location="navigation" class="hidden md:flex items-center gap-2 bg-accent-success/10 hover:bg-accent-success/20 border border-accent-success/40 hover:border-accent-success text-white text-sm font-medium px-5 py-2.5 rounded-full transition-all hover:scale-105">
                <i data-lucide="message-circle" class="w-4 h-4 text-accent-success"></i><span>Falar sobre meu negócio</span>
            </a>
            <button id="mobile-menu-toggle" type="button" class="lg:hidden w-11 h-11 rounded-full bg-white/10 border border-white/20 text-white flex items-center justify-center" aria-expanded="false" aria-controls="mobile-menu" aria-label="Abrir menu">
                <i data-lucide="menu" class="w-5 h-5 menu-open-icon"></i><i data-lucide="x" class="w-5 h-5 menu-close-icon hidden"></i>
            </button>
        </div>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden absolute top-20 left-0 right-0 glass-nav border-t border-white/5 px-6 py-6 shadow-2xl">
        <div class="max-w-7xl mx-auto grid grid-cols-2 gap-2">
            {links.map((link) => <a href={`${basePath}${link.href}`} class="mobile-nav-link px-4 py-3 rounded-xl text-text-secondary hover:text-white hover:bg-white/5 transition-colors">{link.label}</a>)}
        </div>
        <a href={whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-location="mobile_navigation" class="md:hidden mt-4 w-full flex items-center justify-center gap-2 bg-accent-success/15 border border-accent-success/40 text-white font-medium px-5 py-3 rounded-xl"><i data-lucide="message-circle" class="w-4 h-4 text-accent-success"></i> Falar no WhatsApp</a>
    </div>
</nav>

<script>
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const openIcon = toggle?.querySelector('.menu-open-icon');
    const closeIcon = toggle?.querySelector('.menu-close-icon');
    const setMenu = (open: boolean) => {
        menu?.classList.toggle('hidden', !open);
        openIcon?.classList.toggle('hidden', open);
        closeIcon?.classList.toggle('hidden', !open);
        toggle?.setAttribute('aria-expanded', String(open));
        toggle?.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    };
    toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
    document.querySelectorAll('.mobile-nav-link').forEach((link) => link.addEventListener('click', () => setMenu(false)));
</script>
