---
const solucoes = [
    {
        icon: "trending-up", color: "success", titulo: "Gerar mais oportunidades",
        desc: "Transforme atenção em conversa comercial e responda enquanto o interesse ainda está quente.",
        mecanismos: ["Sites e landing pages", "WhatsApp e agentes", "Captação e qualificação"],
    },
    {
        icon: "badge-dollar-sign", color: "primary", titulo: "Reduzir custo operacional",
        desc: "Automatize tarefas repetitivas e conecte ferramentas para o time parar de refazer o mesmo trabalho.",
        mecanismos: ["Automações de processos", "Integrações entre sistemas", "CRM atualizado sozinho"],
    },
    {
        icon: "clock-3", color: "tertiary", titulo: "Ganhar tempo para o que importa",
        desc: "Tire atividades manuais do caminho e dê visibilidade para decidir com mais rapidez.",
        mecanismos: ["Agentes com IA", "Follow-ups e lembretes", "Painéis e sistemas internos"],
    },
];

const colorMap: Record<string, { text: string; bg: string; line: string }> = {
    primary: { text: "text-accent-primary", bg: "from-accent-primary/20", line: "from-accent-primary" },
    tertiary: { text: "text-accent-tertiary", bg: "from-accent-tertiary/20", line: "from-accent-tertiary" },
    success: { text: "text-accent-success", bg: "from-accent-success/20", line: "from-accent-success" },
};
---

<section id="solucoes" class="py-16 md:py-32 relative">
    <div class="absolute inset-0 max-w-7xl mx-auto opacity-20 pointer-events-none bg-gradient-radial from-accent-primary/20 to-transparent blur-[100px]"></div>
    <div class="container mx-auto px-6 lg:px-12 max-w-7xl relative z-10">
        <div class="text-center mb-16 md:mb-20 reveal">
            <p class="text-sm font-bold text-accent-tertiary tracking-widest uppercase mb-4">Soluções</p>
            <h2 class="text-4xl md:text-6xl font-bold text-white tracking-tight mb-6">Começo pelo resultado. Depois escolho a tecnologia.</h2>
            <p class="text-text-secondary text-lg max-w-3xl mx-auto">Site, CRM, automação ou IA não são o produto final. São as peças certas para resolver um problema real do seu negócio.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {solucoes.map((item, i) => (
                <article class="group glass-card p-7 sm:p-9 rounded-2xl sm:rounded-[32px] relative overflow-hidden reveal" style={`transition-delay: ${i * 100}ms;`}>
                    <div class={`absolute top-0 left-0 w-full h-1 bg-gradient-to-r ${colorMap[item.color].line} to-transparent opacity-60`}></div>
                    <div class={`w-16 h-16 rounded-2xl bg-gradient-to-br ${colorMap[item.color].bg} to-transparent flex items-center justify-center mb-7 border border-white/5`}>
                        <i data-lucide={item.icon} class={`w-8 h-8 ${colorMap[item.color].text}`}></i>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-4">{item.titulo}</h3>
                    <p class="text-text-secondary leading-relaxed mb-7">{item.desc}</p>
                    <p class={`text-xs font-mono ${colorMap[item.color].text} uppercase tracking-wider mb-4`}>Como eu faço</p>
                    <ul class="space-y-3">
                        {item.mecanismos.map((mecanismo) => (
                            <li class="flex items-center gap-3 text-sm text-text-muted"><i data-lucide="check" class={`w-4 h-4 ${colorMap[item.color].text}`}></i>{mecanismo}</li>
                        ))}
                    </ul>
                </article>
            ))}
        </div>
    </div>
</section>
