---
import GradientWaves from './GradientWaves.jsx';

const whatsapp = "https://api.whatsapp.com/send?phone=5511921586783&text=Oi%20Gabriel%2C%20vi%20seu%20site%20e%20quero%20entender%20onde%20a%20tecnologia%20pode%20gerar%20resultado%20no%20meu%20neg%C3%B3cio.";
---

<section id="home" class="relative min-h-[92vh] flex items-center pt-32 pb-20 overflow-hidden">
    <div class="absolute inset-0 z-0" aria-hidden="true">
        <GradientWaves
            client:load
            horizonColor="#312e81"
            waveColor="#4f46e5"
            crestColor="#67e8f9"
            backgroundColor="#020410"
            speed={0.18}
            amplitude={2.1}
            waveScale={0.52}
            waveRatio={0.82}
            swell={30}
            turbulence={16}
            tilt={68}
            zoom={0.92}
            height={5.2}
            fogDepth={19}
            relief={0.75}
            lightAngle={118}
            sheen={0.22}
            brightness={0.68}
            opacity={0.9}
            grain={0.12}
            quality="medium"
            parallaxStrength={0.28}
            mouseStrength={0.35}
            swellOnClick={true}
            dpr={1.5}
        />
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_72%_45%,transparent_0%,rgba(2,4,16,0.12)_34%,rgba(2,4,16,0.82)_100%)] pointer-events-none"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-bg-main/20 via-transparent to-bg-main pointer-events-none"></div>
    </div>

    <div class="container mx-auto px-6 lg:px-12 max-w-7xl relative z-10 w-full">
        <div class="flex flex-col-reverse lg:grid lg:grid-cols-12 gap-12 items-center">
            <div class="min-w-0 w-full flex flex-col text-center lg:text-left items-center lg:items-start space-y-8 lg:col-span-7">
                <div class="max-w-full inline-flex items-center gap-2 px-4 py-2 rounded-full glass-card animate-float border border-accent-primary/30 shadow-[0_0_20px_rgba(99,102,241,0.2)]">
                    <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-success opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-accent-success"></span>
                    </span>
                    <span class="text-xs font-semibold text-accent-tertiary tracking-wide uppercase"><span class="sm:hidden">Estratégia e execução</span><span class="hidden sm:inline">Estratégia, produto e execução técnica</span></span>
                </div>

                <h1 class="max-w-full text-[2.65rem] sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight leading-[1.06] text-white">
                    Tecnologia que gera caixa,
                    <span class="text-gradient-accent relative inline-block">
                        reduz custo e economiza tempo.
                        <span class="absolute inset-0 blur-xl bg-accent-primary/20 -z-10" aria-hidden="true"></span>
                    </span>
                </h1>

                <p class="text-lg md:text-xl text-text-secondary max-w-2xl leading-relaxed font-light">
                    Eu construo sistemas digitais, automações e soluções com IA para ajudar empresas a
                    <strong class="text-white font-medium">vender mais, operar melhor e eliminar trabalho manual.</strong>
                </p>

                <div class="flex flex-col sm:flex-row items-center gap-5 w-full sm:w-auto">
                    <a href={whatsapp} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-track-location="hero" class="w-full sm:w-auto px-8 py-4 bg-white text-bg-main font-bold text-base rounded-full shadow-[0_0_40px_rgba(255,255,255,0.3)] hover:shadow-[0_0_60px_rgba(255,255,255,0.5)] hover:-translate-y-1 transition-all duration-300 flex items-center justify-center gap-2 group">
                        <i data-lucide="message-circle" class="w-5 h-5 text-bg-main"></i>
                        <span>Falar no WhatsApp</span>
                        <i data-lucide="arrow-right" class="w-5 h-5 group-hover:translate-x-1 transition-transform text-bg-main"></i>
                    </a>
                    <a href="#resultados" data-track="results_click" data-track-location="hero" class="w-full sm:w-auto px-8 py-4 glass-card rounded-full text-white font-medium text-base hover:bg-white/10 transition-all duration-300 flex items-center justify-center gap-2 border border-white/20">
                        <i data-lucide="chart-no-axes-column" class="w-5 h-5 text-accent-tertiary"></i>
                        Ver resultados
                    </a>
                </div>

                <div class="flex flex-wrap justify-center lg:justify-start gap-x-6 gap-y-3 text-sm text-text-muted">
                    <span class="flex items-center gap-2"><i data-lucide="check" class="w-4 h-4 text-accent-success"></i> Você fala direto comigo</span>
                    <span class="flex items-center gap-2"><i data-lucide="check" class="w-4 h-4 text-accent-success"></i> Solução sob medida</span>
                    <span class="flex items-center gap-2"><i data-lucide="check" class="w-4 h-4 text-accent-success"></i> Foco em resultado</span>
                </div>
            </div>

            <div class="relative w-full max-w-[340px] sm:max-w-[380px] lg:max-w-[420px] flex justify-center lg:justify-end lg:col-span-5">
                <div class="absolute -inset-10 bg-accent-primary/20 blur-[80px] rounded-full animate-pulse-slow pointer-events-none"></div>
                <div class="relative animate-float-slow z-10 w-full aspect-[4/5]">
                    <img src="/img/gabriel-hero.webp" alt="Gabriel Rabelo, especialista em sistemas, automações e soluções com inteligência artificial" class="w-full h-full object-contain object-bottom drop-shadow-2xl" width="900" height="1125" loading="eager" fetchpriority="high" decoding="async" />
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @keyframes float-slow { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }
    .animate-float-slow { animation: float-slow 6s ease-in-out infinite; }
    @media (prefers-reduced-motion: reduce) { .animate-float-slow { animation: none; } }
</style>
