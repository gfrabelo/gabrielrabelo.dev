---
import LegacyTile from './LegacyTile.astro';
const row1 = [
    { src: '/img/anbima.webp', alt: 'ANBIMA Certificações', category: 'Enterprise', title: 'ANBIMA Certificações', desc: 'Sistema de certificações financeiras usado em uma operação de grande escala.', chip: 'ANBIMA 2024–2026', accent: 'primary' as const, idleBorder: true },
    { src: '/img/membership-nike.webp', alt: 'Nike Membership', category: 'E-commerce', title: 'Nike Membership', desc: 'Plataforma de fidelidade e benefícios exclusivos.', chip: 'Nike Brasil', accent: 'primary' as const },
    { src: '/img/central-de-uniformes-nike.webp', alt: 'Nike Central de Uniformes', category: 'Plataforma B2B', title: 'Central de Uniformes', desc: 'Sistema para a gestão de uniformes corporativos.', chip: 'Nike Brasil', accent: 'tertiary' as const },
    { src: '/img/cartao-presente-nike.webp', alt: 'Nike Cartão Presente', category: 'Gift cards', title: 'Cartão Presente', desc: 'Experiência digital para cartões-presente da marca.', chip: 'Nike Brasil', accent: 'secondary' as const },
];
const row2 = [
    { src: '/img/encontre-seu-tenis.webp', alt: 'Nike Encontre seu Tênis', category: 'Experiência interativa', title: 'Encontre seu Tênis', desc: 'Quiz para ajudar consumidores a escolher o produto.', chip: 'Nike Brasil', accent: 'success' as const },
    { src: '/img/carlinhos-maia-jequiti.webp', alt: 'Campanha Jequiti com Carlinhos Maia', category: 'Campanha nacional', title: 'Promo Carlinhos Maia', desc: 'Landing page promocional para campanha nacional.', chip: 'Jequiti', accent: 'primary' as const },
    { src: '/img/eliana-jequiti.webp', alt: 'Campanha Jequiti com Eliana', category: 'Campanha nacional', title: 'Promo Eliana', desc: 'Experiência digital para uma campanha promocional.', chip: 'Jequiti', accent: 'secondary' as const },
    { src: '/img/zenflow.webp', alt: 'ZenFlow', category: 'Produto próprio', title: 'ZenFlow', desc: 'Assistente financeiro com WhatsApp e IA que gerou aprendizados e novas conexões.', chip: 'Produto experimental', accent: 'success' as const, idleBorder: true },
];
---

<section id="credenciais" class="py-16 md:py-28 bg-bg-surface relative border-y border-white/5 overflow-hidden">
    <div class="container mx-auto px-6 lg:px-12 max-w-7xl">
        <div class="max-w-3xl mb-14 reveal">
            <p class="text-sm font-bold text-accent-success tracking-widest uppercase mb-4">Experiência comprovada</p>
            <h2 class="text-4xl md:text-5xl font-bold text-white tracking-tight mb-4">Engenharia testada em marcas que não podem parar.</h2>
            <p class="text-text-secondary text-lg">Nike, ANBIMA e Jequiti funcionam aqui como credenciais: projetos grandes, operação real e responsabilidade de entrega.</p>
        </div>
        <div class="reveal space-y-6">
            <div class="portfolio-marquee-mask relative w-full overflow-hidden"><div class="portfolio-marquee-row flex gap-6" data-credential-row="1">{[...row1, ...row1, ...row1].map((tile) => <LegacyTile {...tile} />)}</div></div>
            <div class="portfolio-marquee-mask relative w-full overflow-hidden"><div class="portfolio-marquee-row flex gap-6" data-credential-row="2">{[...row2, ...row2, ...row2].map((tile) => <LegacyTile {...tile} />)}</div></div>
        </div>
    </div>
</section>

<style>
    .portfolio-marquee-mask { mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent); }
    .portfolio-marquee-row { will-change: transform; }
    @media (prefers-reduced-motion: reduce) { .portfolio-marquee-row { transform: none !important; } }
</style>

<script>
    const section = document.getElementById('credenciais');
    const row1 = section?.querySelector<HTMLElement>('[data-credential-row="1"]');
    const row2 = section?.querySelector<HTMLElement>('[data-credential-row="2"]');
    if (section && row1 && row2 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let ticking = false;
        const update = () => {
            const top = section.getBoundingClientRect().top + window.scrollY;
            const offset = (window.scrollY - top + window.innerHeight) * 0.25;
            row1.style.transform = `translateX(${offset - 140}px)`;
            row2.style.transform = `translateX(${-(offset - 140)}px)`;
            ticking = false;
        };
        window.addEventListener('scroll', () => { if (!ticking) { requestAnimationFrame(update); ticking = true; } }, { passive: true });
        window.addEventListener('resize', update, { passive: true });
        update();
    }
</script>
