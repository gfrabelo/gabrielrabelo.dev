---
const resultados = [
    { value: "Atendimento", label: "respostas consistentes no WhatsApp", detail: "inclusive fora do horário comercial" },
    { value: "Pré-agendamento", label: "leads conduzidos até a agenda", detail: "com menos trabalho manual na recepção" },
    { value: "Operação", label: "mais organizada para a equipe", detail: "com histórico e contexto centralizados" },
];
---

<section id="resultados" class="py-16 md:py-24 bg-bg-surface border-y border-white/5 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-accent-primary/5 via-transparent to-accent-tertiary/5 pointer-events-none"></div>
    <div class="container mx-auto px-6 lg:px-12 max-w-7xl relative z-10">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12 reveal">
            <div class="max-w-3xl">
                <p class="text-sm font-bold text-accent-success tracking-widest uppercase mb-4">Impacto na operação</p>
                <h2 class="text-4xl md:text-5xl font-bold text-white tracking-tight">Quando a tecnologia resolve o problema certo, o impacto aparece no negócio.</h2>
            </div>
            <a href="#cases" data-track="results_click" data-track-location="results_section" class="inline-flex items-center gap-2 text-white font-medium hover:text-accent-tertiary transition-colors">Ver os cases <i data-lucide="arrow-down" class="w-4 h-4"></i></a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-px bg-white/10 rounded-[32px] overflow-hidden border border-white/10 reveal">
            {resultados.map((resultado) => (
                <div class="bg-bg-card/90 p-7 md:p-9">
                    <strong class="block text-3xl md:text-5xl text-white tracking-tight mb-3">{resultado.value}</strong>
                    <span class="block text-text-primary font-medium mb-1">{resultado.label}</span>
                    <span class="text-sm text-text-muted">{resultado.detail}</span>
                </div>
            ))}
        </div>
    </div>
</section>
